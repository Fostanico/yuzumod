				quadTextureSprite = "GFX_tiled_window2_1b_border"
			}
			gridboxtype = {
				name = "yz_bond_graph_lines"
				# The shader draws through the midpoint of its 200px segment. A
				# 0-100 negative offset therefore maps the line to y=125..25.
				position = { x = 88 y = 25 }
				size = { width = 0 height = 200 }
				slotsize = { width = 8 height = 200 }
				max_slots_horizontal = 48
				add_horizontal = yes
			}
