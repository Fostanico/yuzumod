guiTypes = {
	# Opened from the Economic Department decision category. Frequent contract
	# actions remain ordinary decisions; this window controls repayment parameters
	# and presents contract history without adding another periodic callback.
	containerWindowType = {
		name = "yz_bonds_operations_ui"
		position = { x = -490 y = -325 }
		orientation = CENTER
		size = { width = 980 height = 650 }
		moveable = yes
		click_to_front = yes

		background = {
			name = "yz_bonds_operation_ui_background"
