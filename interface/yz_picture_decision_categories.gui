    # Economic Department dashboard. Contract actions remain ordinary decisions;
    # this category owns the single entry to the detailed debt-management window.
    containerWindowType = {
        name = "yz_bond_category_window"
        position = { x = 0 y = -15 }
        size = { width = 500 height = 200 }
        clipping = no

