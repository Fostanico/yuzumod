    # Economic Department dashboard. Contract actions remain ordinary decisions;
    # this category owns the single entry to the detailed debt-management window.
    containerWindowType = {
        name = "yz_bond_category_window"
        position = { x = 0 y = -15 }
        size = { width = 500 height = 200 }
        clipping = no

        background = {
            name = "yz_bond_category_background"
            quadTextureSprite = "GFX_yz_bond_category_bg_brightness_50"
            position = { x = 5 y = -18 }
        }
        buttonType = {
            name = "yz_bond_category_help_button"
            position = { x = -42 y = -4 }
            orientation = UPPER_RIGHT
            quadTextureSprite = "GFX_help_button"
            buttonText = ""
            buttonFont = "Main_14_black"
            clicksound = click_ok
            oversound = ui_menu_over
            pdx_tooltip = "yz_bond_help_button_tt"
        }
		buttonType = {
			name = "yz_bond_category_auto_button"
			# The automation sprite is 32px high while the help icon is 24px.
			# Raising it by four pixels aligns their visual centres.
			position = { x = -78 y = -8 }
			orientation = UPPER_RIGHT
			quadTextureSprite = "GFX_yz_bond_automation_toggle"
			clicksound = click_default
			oversound = ui_menu_over
			pdx_tooltip = "yz_bond_auto_button_tt"
